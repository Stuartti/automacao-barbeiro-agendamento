      "parameters": {
        "jsCode": "if (!$json['horário']) {\n  throw new Error('Horário não informado (campo horário veio vazio/null).');\n}\n\nconst data = $json.data;\nconst hora = $json[\"horário\"];\n\nconst start = `${data}T${hora}:00`;\n\nconst endDate = new Date(start);\nendDate.setMinutes(endDate.getMinutes() + 30);\n\nconst pad = (n) => String(n).padStart(2, '0');\nconst end =\n  `${endDate.getFullYear()}-${pad(endDate.getMonth()+1)}-${pad(endDate.getDate())}` +\n  `T${pad(endDate.getHours())}:${pad(endDate.getMinutes())}:00`;\n\nreturn [{ ...$json, start, end }];"
      },
